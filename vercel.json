{
  "rewrites": [
    {
      "source": "/bni-analysis-deira-dubai",
      "destination": "https://bni-analysis-deira-dubai.vercel.app"
    },
    {
      "source": "/bni-analysis-deira-dubai/:path*",
      "destination": "https://bni-analysis-deira-dubai.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/bni-analysis-deira-dubai/:path*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
